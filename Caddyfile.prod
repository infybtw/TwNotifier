# Production proxy: serves the static SPA and forwards the API to the bot.
# Provider webhooks keep their own paths and are never rewritten to the SPA.
#
# Set the public hostname with:  {$WEB_DOMAIN:localhost}
{$WEB_DOMAIN:localhost} {
	encode zstd gzip

	# Versioned assets can be cached aggressively.
	@assets path /_nuxt/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# The HTML entrypoint is revalidated so new builds are picked up.
	@html path / /index.html /200.html /404.html
	header @html Cache-Control "no-cache"

	handle /api/v1/* {
		reverse_proxy app:3000
	}

	# Twitch/Kick webhook paths configured through the environment.
	@webhooks path {$KICK_WEBHOOK_PATH} {$TWITCH_WEBHOOK_PATH}
	handle @webhooks {
		reverse_proxy app:3000
	}

	# Everything else is the SPA; unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Allow embedding inside the Telegram Web iframe; keep the default frame
	# ancestors otherwise unset to avoid blocking Telegram Web (iframe).
	header {
		-Server
	}
}
