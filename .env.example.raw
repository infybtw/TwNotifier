# KEY=VALUE values to store in the Doppler config (see .env.example header).
# The `twn` entrypoint injects these at container start via `doppler run`.
# Keep DATABASE_URL out — it is built in app/config.ts from POSTGRES_*.
CLIENT_ID=
CLIENT_SECRET=
BOT_USER_ID=
TWITCH_EVENT_TRANSPORT=
TWITCH_WEBHOOK_SECRET=
BOT_URL=
SHARD_COUNT=1
TWITCH_WS=wss://eventsub.wss.twitch.tv/ws
TWITCH_HELIX=https://api.twitch.tv
TWITCH_OAUTH=https://id.twitch.tv
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_API=https://api.kick.com
KICK_OAUTH=https://id.kick.com
BOT_TOKEN=
DEFAULT_LANGUAGE=ru
ADMINER_URL=
# --- Postgres backups (S3, used by ghcr.io/infybtw/postgres-backup) ---
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=
S3_REGION=
S3_ENDPOINT=
WEB_APP_URL=
BOT_USERNAME=
SESSION_TTL_SECONDS=3600
INIT_DATA_MAX_AGE_SECONDS=300
INIT_DATA_FUTURE_SKEW_SECONDS=30
INIT_DATA_MAX_BYTES=8192
API_PATH=/api/v1
API_RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:3001
