# Twitch API Credentials
CLIENT_ID=TWITCH_CLIENT_ID
CLIENT_SECRET=TWITCH_CLIENT_SECRET
BOT_USER_ID=BOT_USER_ID(not required)

KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

KICK_API=https://api.kick.com
KICK_OAUTH=https://id.kick.com
KICK_WEBHOOK_PATH=
HTTP_SERVER_PORT=


# Admin panel links (optional, leave empty to hide buttons)
ADMINER_URL=
PGBACKWEB_URL=

# Twitch EventSub Configuration
SHARD_COUNT=1

# Twitch EventSub Transport: "webhook" or "conduit" (required)
TWITCH_EVENT_TRANSPORT=

# Webhook config (required when TWITCH_EVENT_TRANSPORT=webhook)
TWITCH_WEBHOOK_PATH=
TWITCH_WEBHOOK_SECRET=
BOT_URL=https://your-domain.com

# Telegram Bot Token
BOT_TOKEN=TELEGRAM_BOT_TOKEN

TWITCH_WS=TWITCH_WS_URL
TWITCH_HELIX=TWITCH_HELIX_URL
TWITCH_OAUTH=TWITCH_OAUTH_URL
DATABASE_URL=DATABASE_URL

# Default language for new users (ru or en)
DEFAULT_LANGUAGE=ru

# --- Telegram Mini App / REST API ---
# Public HTTPS URL of the Mini App (used for launch/menu links)
WEB_APP_URL=
# Bot username without the leading @, used to build share/deep links
BOT_USERNAME=
# Server-side session lifetime (seconds)
SESSION_TTL_SECONDS=3600
# Maximum accepted initData age (seconds) and allowed future clock skew
INIT_DATA_MAX_AGE_SECONDS=300
INIT_DATA_FUTURE_SKEW_SECONDS=30
# Maximum accepted initData body size (bytes)
INIT_DATA_MAX_BYTES=8192
# Requests per minute per client for auth and mutations
API_RATE_LIMIT_PER_MINUTE=60
