# --- Doppler (backend pulls secrets at container start) ---
# Doppler service token scoped to one project/config. When set, the `twn`
# entrypoint runs `doppler run` and injects the config's secrets on top of
# the container environment. Leave empty to use plain .env values instead.
DOPPLER_TOKEN=

# --- PostgreSQL (DATABASE_URL is built from these, do not set it) ---
POSTGRES_USER=infydev
POSTGRES_PASSWORD=infy.dev
POSTGRES_DB=twn
# Compose: service name and internal port. Local host process: localhost and 54322.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Compose ports (read by compose.yaml from this file) ---
HTTP_SERVER_PORT=3000
WEB_SERVER_PORT=3001
ADMINER_PORT=8080
DUMPKEEPER_PORT=8085
DUMPKEEPER_AUTH_LOGIN=
DUMPKEEPER_AUTH_PASSWORD=
DUMPKEEPER_BASE_PATH=/

# --- Frontend build args (web/, read by compose.yaml from this file) ---
NUXT_PUBLIC_BOT_USERNAME=
NUXT_PUBLIC_API_BASE=

# --- Twitch ---
CLIENT_ID=
CLIENT_SECRET=
BOT_USER_ID=
TWITCH_EVENT_TRANSPORT=
TWITCH_WEBHOOK_SECRET=
BOT_URL=
SHARD_COUNT=1
TWITCH_WS=wss://eventsub.wss.twitch.tv/ws
TWITCH_HELIX=https://api.twitch.tv
TWITCH_OAUTH=https://id.twitch.tv

# --- Kick ---
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_API=https://api.kick.com
KICK_OAUTH=https://id.kick.com

# --- Telegram bot ---
BOT_TOKEN=
DEFAULT_LANGUAGE=ru

# --- Admin panel links (leave empty to hide the buttons) ---
ADMINER_URL=
DUMPKEEPER_URL=

# --- Telegram Mini App / REST API ---
# Public HTTPS URL of the Mini App. TLS is terminated in front of the container.
WEB_APP_URL=
# Bot username without the leading @
BOT_USERNAME=
SESSION_TTL_SECONDS=3600
INIT_DATA_MAX_AGE_SECONDS=300
INIT_DATA_FUTURE_SKEW_SECONDS=30
INIT_DATA_MAX_BYTES=8192
API_PATH=/api/v1
API_RATE_LIMIT_PER_MINUTE=60
# Comma-separated browser origins allowed to call the REST API.
CORS_ORIGINS=http://localhost:3001

# --- Local dev only (Vite dev server) ---
# Comma-separated hosts accepted for public tunnels, e.g. rp2.infybtw.dev,abc.ngrok-free.app
DEV_ALLOWED_HOSTS=
