# Environment variables for local runs and the Docker stacks.
# Copy to `.env` and fill in the values; the file is git-ignored.
#
# Production: the Ansible deploy renders `.env` on the server from
# `deploy/ansible/vault.yaml` and `deploy/ansible/templates/.env.j2`.
# The canonical key list lives in `deploy/ansible/vault.example.yaml`.
#
# DATABASE_URL is built in app/config.ts from POSTGRES_* — do not set it.

# --- Telegram bot ---
BOT_TOKEN=
BOT_USER_ID=
BOT_URL=
BOT_USERNAME=
DEFAULT_LANGUAGE=ru

# --- Twitch API / EventSub ---
CLIENT_ID=
CLIENT_SECRET=
# EventSub transport: "conduit" (WebSocket) or "webhook".
TWITCH_EVENT_TRANSPORT=conduit
# Required only when TWITCH_EVENT_TRANSPORT=webhook.
TWITCH_WEBHOOK_SECRET=
TWITCH_WS=wss://eventsub.wss.twitch.tv/ws
TWITCH_HELIX=https://api.twitch.tv
TWITCH_OAUTH=https://id.twitch.tv
SHARD_COUNT=1

# --- Kick API / webhooks ---
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_API=https://api.kick.com
KICK_OAUTH=https://id.kick.com

# --- Telegram Mini App / REST API ---
WEB_APP_URL=
ADMINER_URL=
API_PATH=/api/v1
API_RATE_LIMIT_PER_MINUTE=60
SESSION_TTL_SECONDS=3600
INIT_DATA_MAX_AGE_SECONDS=300
INIT_DATA_FUTURE_SKEW_SECONDS=30
INIT_DATA_MAX_BYTES=8192
CORS_ORIGINS=http://localhost:3001

# --- PostgreSQL (DATABASE_URL is built from these, do not set it) ---
POSTGRES_USER=infydev
POSTGRES_PASSWORD=infy.dev
POSTGRES_DATABASE=twn
# Compose: service name and internal port. Local host process: localhost and 54322.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Compose ports (read by compose.yaml from this file) ---
HTTP_SERVER_PORT=3000
WEB_SERVER_PORT=3001
# Хост-порт единой точки входа edge_proxy (контейнер всегда слушает :80).
# Сюда же должен слать внешний Caddy: reverse_proxy 127.0.0.1:80 (или IP хоста).
EDGE_HTTP_PORT=80

# --- Image tag for the twn/web containers ---
# Ansible deploy fills this in with the latest git tag (see deploy/ansible).
# Leave unset/empty and compose falls back to `latest`; set it to pin a release.
TWN_VERSION=

# --- Postgres backups (ghcr.io/infybtw/postgres-backup, no UI, dumps to S3) ---
# Cron schedule for regular backups, e.g. "0 2 * * *" = every day at 02:00.
# Leave empty to run a single backup on container start and exit.
BACKUP_SCHEDULE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=
S3_REGION=
S3_ENDPOINT=

# --- Local dev only (docker-compose.dev.yml + Vite dev server) ---
# Frontend build args baked into the web/ image by the dev stack.
NUXT_PUBLIC_BOT_USERNAME=
NUXT_PUBLIC_API_BASE=
# Comma-separated hosts accepted for public tunnels, e.g. rp2.infybtw.dev,abc.ngrok-free.app
DEV_ALLOWED_HOSTS=
