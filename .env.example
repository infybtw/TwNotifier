# Only what Compose interpolation and the containers' plain environment need
# (see compose.yaml / docker-compose.dev.yml). All app secrets (Twitch, Kick,
# Telegram, Mini App API...) are pulled from Doppler: the `twn` entrypoint runs
# `doppler run` at container start and injects them on top of this file.
# The KEY=VALUE list to keep in Doppler is in `.env.example.raw`.

# --- Doppler bootstrap ---
# Doppler service token scoped to one project/config; project and config are
# bound to it. Leave empty to run the app with plain .env values (local dev
# without Doppler).
DOPPLER_TOKEN=

# --- PostgreSQL (DATABASE_URL is built from these, do not set it) ---
POSTGRES_USER=infydev
POSTGRES_PASSWORD=infy.dev
POSTGRES_DATABASE=twn
# Compose: service name and internal port. Local host process: localhost and 54322.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Compose ports (read by compose.yaml from this file) ---
HTTP_SERVER_PORT=3000
WEB_SERVER_PORT=3001
ADMINER_PORT=8080
# Хост-порт единой точки входа edge_proxy (контейнер всегда слушает :80).
# Сюда же должен слать внешний Caddy: reverse_proxy 127.0.0.1:80 (или IP хоста).
EDGE_HTTP_PORT=80

# --- Postgres backups (ghcr.io/infybtw/postgres-backup, no UI, dumps to S3) ---
# Cron schedule for regular backups, e.g. "0 2 * * *" = every day at 02:00.
# Leave empty to run a single backup on container start and exit.
# S3_* credentials live in Doppler (see .env.example.raw): the backup container
# reads DOPPLER_TOKEN from this file and pulls them via `doppler run`.
BACKUP_SCHEDULE=

# --- Local dev only (docker-compose.dev.yml + Vite dev server) ---
# Frontend build args baked into the web/ image by the dev stack.
NUXT_PUBLIC_BOT_USERNAME=
NUXT_PUBLIC_API_BASE=
# Comma-separated hosts accepted for public tunnels, e.g. rp2.infybtw.dev,abc.ngrok-free.app
DEV_ALLOWED_HOSTS=
