# Twitch API Credentials
CLIENT_ID=TWITCH_CLIENT_ID
CLIENT_SECRET=TWITCH_CLIENT_SECRET
BOT_USER_ID=BOT_USER_ID(not required)

KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

KICK_API=https://api.kick.com
KICK_OAUTH=https://id.kick.com
KICK_WEBHOOK_PATH=
# Public port of the backend API container.
HTTP_SERVER_PORT=3000
# Public port of the static Mini App container.
WEB_SERVER_PORT=3001

# Local PostgreSQL container credentials (used by docker-compose.dev.yml).
POSTGRES_USER=infydev
POSTGRES_PASSWORD=infy.dev
POSTGRES_DB=twn


# Admin panel links (optional, leave empty to hide buttons)
ADMINER_URL=
PGBACKWEB_URL=

# Twitch EventSub Configuration
SHARD_COUNT=1

# Twitch EventSub Transport: "webhook" or "conduit" (required)
TWITCH_EVENT_TRANSPORT=

# Webhook config (required when TWITCH_EVENT_TRANSPORT=webhook)
TWITCH_WEBHOOK_PATH=
TWITCH_WEBHOOK_SECRET=
BOT_URL=https://your-domain.com

# Telegram Bot Token
BOT_TOKEN=TELEGRAM_BOT_TOKEN

TWITCH_WS=TWITCH_WS_URL
TWITCH_HELIX=TWITCH_HELIX_URL
TWITCH_OAUTH=TWITCH_OAUTH_URL
# Docker Compose uses the PostgreSQL service hostname and its internal port.
# For a local host process instead, use localhost:54322.
DATABASE_URL=postgres://infydev:infy.dev@postgres:5432/twn

# Default language for new users (ru or en)
DEFAULT_LANGUAGE=ru

# --- Telegram Mini App / REST API ---
# Public HTTPS URL of the Mini App (used for launch/menu links). TLS must be
# terminated by the infrastructure in front of this exposed container.
WEB_APP_URL=
# Bot username without the leading @, used to build share/deep links
BOT_USERNAME=
# Server-side session lifetime (seconds)
SESSION_TTL_SECONDS=3600
# Maximum accepted initData age (seconds) and allowed future clock skew
INIT_DATA_MAX_AGE_SECONDS=300
INIT_DATA_FUTURE_SKEW_SECONDS=30
# Maximum accepted initData body size (bytes)
INIT_DATA_MAX_BYTES=8192
# URL prefix for every Mini App REST API route.
API_PATH=/api/v1
# Requests per minute per client for auth and mutations
API_RATE_LIMIT_PER_MINUTE=60
# Comma-separated browser origins allowed to call the REST API.
# Set this to the Mini App's HTTPS origin when NUXT_PUBLIC_API_BASE is another origin.
# CORS_ORIGINS=https://app.example.com,http://localhost:3001
CORS_ORIGINS=http://localhost:3001

# --- Frontend development only (web/) ---
# Comma-separated hosts the Vite dev server accepts, for public tunnels:
# DEV_ALLOWED_HOSTS=rp2.infybtw.dev,abc.ngrok-free.app
DEV_ALLOWED_HOSTS=
# Public bot username and API base baked into the Mini App image at build time.
# With separate containers, use an absolute public API URL, for example:
# NUXT_PUBLIC_API_BASE=https://api.example.com/api/v1
# Leave empty to use API_PATH (for a same-origin frontend/API deployment).
NUXT_PUBLIC_BOT_USERNAME=
NUXT_PUBLIC_API_BASE=
