---
import AppLayout from "../../../layouts/AppLayout.astro";
import BackLink from "../../../components/BackLink.astro";
import Pagination from "../../../components/Pagination.astro";

const { id } = Astro.params;
---
<AppLayout>
  <section id="page-admin-user" data-page="admin-user" class="flex flex-col gap-4" data-user-id={id}>
    <BackLink href="/admin/users" />
    <div data-user-state></div>

    <div class="flex flex-col gap-4" data-user-detail hidden>
      <div data-user-header></div>

      <nav class="section-switcher" data-user-sections data-i18n-aria-label="admin.user.sections">
        <button type="button" data-user-tab="overview" aria-pressed="true" data-i18n="admin.user.tab_overview"></button>
        <button type="button" data-user-tab="settings" aria-pressed="false" data-i18n="admin.user.tab_settings"></button>
        <button type="button" data-user-tab="follows" aria-pressed="false" data-i18n="admin.user.tab_follows"></button>
        <button type="button" data-user-tab="notifications" aria-pressed="false" data-i18n="admin.user.tab_notifications"></button>
      </nav>

      <div data-user-pane="overview"></div>
      <div data-user-pane="settings" hidden></div>

      <section data-user-pane="follows" class="flex flex-col gap-2" data-paginated hidden>
        <h2 class="text-sm font-semibold tg-text" data-user-follows-title></h2>
        <div data-user-follows-list></div>
        <Pagination labelKey="admin.user.tab_follows" />
      </section>

      <section data-user-pane="notifications" class="flex flex-col gap-2" data-paginated hidden>
        <h2 class="text-sm font-semibold tg-text" data-user-notifications-title></h2>
        <div data-user-notifications-list></div>
        <Pagination labelKey="admin.user.tab_notifications" />
      </section>

      <p class="text-sm tg-destructive" data-user-error hidden></p>
    </div>
  </section>
</AppLayout>

