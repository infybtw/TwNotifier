---
import AppLayout from "../../layouts/AppLayout.astro";
import BackLink from "../../components/BackLink.astro";
import Pagination from "../../components/Pagination.astro";
---
<AppLayout>
  <section id="page-admin-logs" data-page="admin-logs" class="flex flex-col gap-4" data-paginated>
    <BackLink href="/admin" labelKey="admin.title" />
    <header class="flex items-baseline justify-between gap-2">
      <h1 class="text-lg font-semibold tracking-tight tg-text" data-i18n="admin.logs.title"></h1>
      <button type="button" data-logs-refresh class="text-xs font-medium tg-link" data-i18n="common.refresh"></button>
    </header>

    <div data-logs-list></div>
    <Pagination />
  </section>
</AppLayout>

