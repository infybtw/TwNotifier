---
import AppLayout from "../../layouts/AppLayout.astro";
---
<AppLayout>
  <section id="page-admin-broadcast" data-page="admin-broadcast" class="flex flex-col gap-4">
    <h1 class="text-lg font-semibold tracking-tight tg-text" data-i18n="admin.broadcast.title"></h1>

    <textarea
      rows="5"
      data-broadcast-text
      class="w-full resize-none rounded-2xl px-4 py-3 text-sm tg-card tg-text placeholder:text-[var(--tg-hint)]"
      data-i18n-placeholder="admin.broadcast.text"
      data-i18n-aria-label="admin.broadcast.text"
      maxlength="4096"
    ></textarea>

    <div class="rounded-2xl p-4 tg-card">
      <label class="block cursor-pointer text-sm font-medium tg-link">
        <span data-broadcast-photo-label data-i18n="admin.broadcast.photo"></span>
        <input type="file" accept="image/*" class="sr-only" data-broadcast-file />
      </label>
      <div class="mt-3 flex flex-col gap-2" data-broadcast-preview hidden>
        <img src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="" data-broadcast-image class="max-h-48 w-fit rounded-xl object-cover" />
        <button type="button" class="self-start text-xs font-medium tg-destructive" data-broadcast-clear data-i18n="common.remove"></button>
      </div>
    </div>

    <button type="button" data-broadcast-send class="rounded-xl px-4 py-3 text-sm font-semibold tg-button" data-i18n="admin.broadcast.send" disabled></button>

    <p class="rounded-2xl px-4 py-3 text-sm tg-card tg-text" data-broadcast-result hidden></p>
    <p class="text-sm tg-destructive" data-broadcast-error hidden></p>
  </section>
</AppLayout>

