---
import AppLayout from "../../layouts/AppLayout.astro";
import BackLink from "../../components/BackLink.astro";
import Pagination from "../../components/Pagination.astro";
---
<AppLayout>
  <section id="page-admin-channels" data-page="admin-channels" class="flex flex-col gap-4" data-paginated>
    <BackLink href="/admin" labelKey="admin.title" />
    <h1 class="text-lg font-semibold tracking-tight tg-text" data-i18n="admin.channels.title"></h1>

    <div class="flex gap-2" role="group">
      <button type="button" data-platform="" class="rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors tg-secondary tg-text" aria-pressed="false" data-i18n="follows.filter_all"></button>
      <button type="button" data-platform="twitch" class="rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors tg-secondary tg-text" aria-pressed="false" data-i18n="follows.filter_twitch"></button>
      <button type="button" data-platform="kick" class="rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors tg-secondary tg-text" aria-pressed="false" data-i18n="follows.filter_kick"></button>
    </div>

    <div data-channels-list></div>
    <Pagination />
  </section>
</AppLayout>

