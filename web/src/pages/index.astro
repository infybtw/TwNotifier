---
import AppLayout from "../layouts/AppLayout.astro";
import Pagination from "../components/Pagination.astro";
---
<AppLayout>
  <section id="page-follows" data-page="follows" class="flex flex-col gap-4" data-paginated>
    <header class="flex flex-wrap items-baseline justify-between gap-2">
      <h1 class="text-lg font-semibold tracking-tight tg-text" data-i18n="follows.title"></h1>
      <p class="text-xs tg-hint" data-follows-summary></p>
    </header>

    <input
      type="search"
      data-follows-search
      class="w-full rounded-xl px-4 py-2.5 text-sm tg-card tg-text placeholder:text-[var(--tg-hint)]"
      data-i18n-placeholder="follows.search"
      data-i18n-aria-label="follows.search"
      maxlength="64"
    />

    <div class="flex gap-2" role="group">
      <button type="button" data-platform="" class="rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors tg-secondary tg-text" aria-pressed="false" data-i18n="follows.filter_all"></button>
      <button type="button" data-platform="twitch" class="rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors tg-secondary tg-text" aria-pressed="false" data-i18n="follows.filter_twitch"></button>
      <button type="button" data-platform="kick" class="rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors tg-secondary tg-text" aria-pressed="false" data-i18n="follows.filter_kick"></button>
    </div>

    <div data-follows-list></div>
    <Pagination />
  </section>
</AppLayout>

