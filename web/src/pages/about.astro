---
import AppLayout from "../layouts/AppLayout.astro";

const username = (import.meta.env.PUBLIC_BOT_USERNAME ?? "").trim();
const botUrl = username ? `https://t.me/${username}` : "";
---
<AppLayout>
  <section class="flex flex-col gap-4">
    <h1 class="text-lg font-semibold tracking-tight tg-text" data-i18n="about.title"></h1>

    <div class="flex flex-col gap-2.5 rounded-2xl p-4 tg-card">
      <p class="text-sm tg-text" data-i18n="about.description"></p>
      <p class="text-sm tg-hint" data-i18n="about.platforms"></p>
      <p class="text-sm tg-hint" data-i18n="about.notifications"></p>
      <p class="text-sm tg-hint" data-i18n="about.commands"></p>
    </div>

    <a
      href="https://github.com/infybtw/twnotifier"
      target="_blank"
      rel="noopener"
      class="rounded-xl px-4 py-3 text-center text-sm font-semibold tg-secondary tg-text"
      data-i18n="about.github"
    ></a>

    {botUrl && (
      <a
        href={botUrl}
        target="_blank"
        rel="noopener"
        class="rounded-xl px-4 py-3 text-center text-sm font-semibold tg-button"
        data-i18n="about.open_chat"
      ></a>
    )}
  </section>
</AppLayout>
