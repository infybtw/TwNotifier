---
import { ClientRouter } from "astro:transitions";
import AppHeader from "../components/AppHeader.astro";
import BottomNav from "../components/BottomNav.astro";
import ConfirmDialog from "../components/ConfirmDialog.astro";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "TwNotifier" } = Astro.props;
---
<!doctype html>
<html lang="ru" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1f2937" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <!-- The official bridge must be present before initialization. -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <ClientRouter />
  </head>
  <body>
    <div id="app-root" class="min-h-[100dvh] tg-bg">
      <div id="app-shell" class="app-shell" data-shell hidden>
        <!-- Shell bars persist across client-side navigation, like the old layout. -->
        <AppHeader transition:persist="app-header" />
        <main id="app-main" class="app-main mx-auto w-full max-w-2xl px-4 py-4">
          <div id="delivery-banner" data-delivery-banner hidden></div>
          <slot />
        </main>
        <BottomNav transition:persist="bottom-nav" />
      </div>
      <div id="onboarding" data-onboarding></div>
    </div>
    <ConfirmDialog />
    <script>
      import "../lib/app";
    </script>
  </body>
</html>
