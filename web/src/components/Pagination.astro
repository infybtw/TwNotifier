---
interface Props {
  /** Translation key for the pager's accessible name. */
  labelKey?: string;
}

const { labelKey = "pagination.label" } = Astro.props;
---
<nav class="pagination" data-pager data-i18n-aria-label={labelKey} aria-busy="false" hidden>
  <p class="pagination-status" data-pager-status role="status" aria-live="polite" aria-atomic="true"></p>
  <div class="pagination-actions">
    <button type="button" data-pager-prev>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m14 7-5 5 5 5" /></svg>
      <span data-i18n="pagination.previous"></span>
    </button>
    <button type="button" data-pager-next>
      <span data-i18n="pagination.next"></span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m10 7 5 5-5 5" /></svg>
    </button>
  </div>
</nav>
