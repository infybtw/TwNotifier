# Ansible managed: rendered from templates/.env.j2 with vault.yaml — do not edit manually.
# Every value here comes from the vault and is injected into the containers
# through `env_file: .env`.

# --- Telegram bot ---
BOT_TOKEN={{ BOT_TOKEN }}
BOT_USER_ID={{ BOT_USER_ID }}
BOT_URL={{ BOT_URL }}
BOT_USERNAME={{ BOT_USERNAME }}
DEFAULT_LANGUAGE={{ DEFAULT_LANGUAGE }}

# --- Twitch API / EventSub ---
CLIENT_ID={{ CLIENT_ID }}
CLIENT_SECRET={{ CLIENT_SECRET }}
TWITCH_EVENT_TRANSPORT={{ TWITCH_EVENT_TRANSPORT }}
TWITCH_WEBHOOK_SECRET={{ TWITCH_WEBHOOK_SECRET }}
TWITCH_WS={{ TWITCH_WS }}
TWITCH_HELIX={{ TWITCH_HELIX }}
TWITCH_OAUTH={{ TWITCH_OAUTH }}
SHARD_COUNT={{ SHARD_COUNT }}

# --- Kick API / webhooks ---
KICK_CLIENT_ID={{ KICK_CLIENT_ID }}
KICK_CLIENT_SECRET={{ KICK_CLIENT_SECRET }}
KICK_API={{ KICK_API }}
KICK_OAUTH={{ KICK_OAUTH }}

# --- Telegram Mini App / REST API ---
WEB_APP_URL={{ WEB_APP_URL }}
DBX_URL={{ DBX_URL | default('https://twn.infybtw.dev/dbx', true) }}
API_PATH={{ API_PATH }}
API_RATE_LIMIT_PER_MINUTE={{ API_RATE_LIMIT_PER_MINUTE }}
SESSION_TTL_SECONDS={{ SESSION_TTL_SECONDS }}
INIT_DATA_MAX_AGE_SECONDS={{ INIT_DATA_MAX_AGE_SECONDS }}
INIT_DATA_FUTURE_SKEW_SECONDS={{ INIT_DATA_FUTURE_SKEW_SECONDS }}
INIT_DATA_MAX_BYTES={{ INIT_DATA_MAX_BYTES }}
CORS_ORIGINS={{ CORS_ORIGINS }}

# --- PostgreSQL credentials; DATABASE_URL is built from these, do not set it ---
POSTGRES_USER={{ POSTGRES_USER }}
POSTGRES_PASSWORD={{ POSTGRES_PASSWORD }}
POSTGRES_DATABASE={{ POSTGRES_DATABASE }}
POSTGRES_HOST={{ POSTGRES_HOST | default('postgres') }}
POSTGRES_PORT={{ POSTGRES_PORT | default('5432') }}

# --- Internal container ports ---
HTTP_SERVER_PORT={{ HTTP_SERVER_PORT | default('3000') }}
WEB_SERVER_PORT={{ WEB_SERVER_PORT | default('3001') }}

# --- Cloudflare Tunnel ---
TUNNEL_TOKEN={{ TUNNEL_TOKEN }}

# Image tag for compose: latest release tag, resolved at deploy time.
# Set TWN_VERSION in vault.yaml to pin a specific release.
TWN_VERSION={{ TWN_VERSION | default(twn_version) }}

# --- Postgres backups (S3) ---
BACKUP_SCHEDULE="{{ BACKUP_SCHEDULE | default('') }}"
S3_ACCESS_KEY_ID={{ S3_ACCESS_KEY_ID }}
S3_SECRET_ACCESS_KEY={{ S3_SECRET_ACCESS_KEY }}
S3_BUCKET={{ S3_BUCKET }}
S3_PREFIX={{ S3_PREFIX }}
S3_REGION={{ S3_REGION }}
S3_ENDPOINT={{ S3_ENDPOINT }}
