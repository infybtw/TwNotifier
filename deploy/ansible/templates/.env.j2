# Ansible managed: rendered from templates/.env.j2 with vault.yaml — do not edit manually.
# Only the Doppler bootstrap token and what Compose reads directly (.env.example).
# Backend secrets are injected by `doppler run` at container start (.env.example.raw).

DOPPLER_TOKEN={{ DOPPLER_TOKEN }}

POSTGRES_USER={{ POSTGRES_USER }}
POSTGRES_PASSWORD={{ POSTGRES_PASSWORD }}
POSTGRES_DATABASE={{ POSTGRES_DATABASE }}
POSTGRES_HOST={{ POSTGRES_HOST | default('postgres') }}
POSTGRES_PORT={{ POSTGRES_PORT | default('5432') }}

HTTP_SERVER_PORT={{ HTTP_SERVER_PORT | default('3000') }}
WEB_SERVER_PORT={{ WEB_SERVER_PORT | default('3001') }}

BACKUP_SCHEDULE="{{ BACKUP_SCHEDULE | default('') }}"
