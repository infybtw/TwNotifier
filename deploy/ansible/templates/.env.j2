# Ansible managed: rendered from templates/.env.j2 with vault.yaml — do not edit manually.
# --- Doppler bootstrap (backend pulls secrets at runtime) ---
DOPPLER_TOKEN={{ DOPPLER_TOKEN }}

# --- Twitch API credentials ---
CLIENT_ID={{ CLIENT_ID }}
CLIENT_SECRET={{ CLIENT_SECRET }}
BOT_USER_ID={{ BOT_USER_ID }}

# --- Kick API credentials ---
KICK_CLIENT_ID={{ KICK_CLIENT_ID }}
KICK_CLIENT_SECRET={{ KICK_CLIENT_SECRET }}
KICK_API={{ KICK_API }}
KICK_OAUTH={{ KICK_OAUTH }}

# --- Docker Compose (compose.yaml / docker-compose.dev.yml) ---
# Port of the backend API container (bound to 127.0.0.1 in production).
HTTP_SERVER_PORT={{ HTTP_SERVER_PORT }}
# Port of the static Mini App container.
WEB_SERVER_PORT={{ WEB_SERVER_PORT }}
# Host port of the adminer UI (bound to 127.0.0.1 in production).
ADMINER_PORT={{ ADMINER_PORT }}

# PostgreSQL credentials; DATABASE_URL is built from these, do not set it.
POSTGRES_USER={{ POSTGRES_USER }}
POSTGRES_PASSWORD={{ POSTGRES_PASSWORD }}
POSTGRES_DB={{ POSTGRES_DB }}
# Compose: service name and internal port. Local host process: localhost and 54322.
POSTGRES_HOST={{ POSTGRES_HOST | default('postgres') }}
POSTGRES_PORT={{ POSTGRES_PORT | default('5432') }}

# --- Admin panel (optional, leave a URL empty to hide its button) ---
# Public URLs opened from the bot's admin keyboard.
ADMINER_URL={{ ADMINER_URL }}
DUMPKEEPER_URL={{ DUMPKEEPER_URL }}
# Host port and credentials of the dumpkeeper backup UI.
# DUMPKEEPER_URL must include DUMPKEEPER_BASE_PATH when it is not "/".
DUMPKEEPER_PORT={{ DUMPKEEPER_PORT }}
DUMPKEEPER_AUTH_LOGIN={{ DUMPKEEPER_AUTH_LOGIN }}
DUMPKEEPER_AUTH_PASSWORD={{ DUMPKEEPER_AUTH_PASSWORD }}
DUMPKEEPER_BASE_PATH={{ DUMPKEEPER_BASE_PATH }}

# --- Twitch EventSub ---
SHARD_COUNT={{ SHARD_COUNT }}

# Twitch EventSub transport: "webhook" or "conduit" (required)
TWITCH_EVENT_TRANSPORT={{ TWITCH_EVENT_TRANSPORT }}

# Webhook config (required when TWITCH_EVENT_TRANSPORT=webhook)
# Webhook paths are static: /webhook/kick and /webhook/twitch
TWITCH_WEBHOOK_SECRET={{ TWITCH_WEBHOOK_SECRET }}
BOT_URL={{ BOT_URL }}

# --- Telegram bot ---
BOT_TOKEN={{ BOT_TOKEN }}

# --- Twitch endpoints ---
TWITCH_WS={{ TWITCH_WS }}
TWITCH_HELIX={{ TWITCH_HELIX }}
TWITCH_OAUTH={{ TWITCH_OAUTH }}

# Default language for new users (ru or en)
DEFAULT_LANGUAGE={{ DEFAULT_LANGUAGE }}

# --- Telegram Mini App / REST API ---
# Public HTTPS URL of the Mini App (used for launch/menu links). TLS must be
# terminated by the infrastructure in front of this exposed container.
WEB_APP_URL={{ WEB_APP_URL }}
# Bot username without the leading @, used to build share/deep links
BOT_USERNAME={{ BOT_USERNAME }}
# Server-side session lifetime (seconds)
SESSION_TTL_SECONDS={{ SESSION_TTL_SECONDS }}
# Maximum accepted initData age (seconds) and allowed future clock skew
INIT_DATA_MAX_AGE_SECONDS={{ INIT_DATA_MAX_AGE_SECONDS }}
INIT_DATA_FUTURE_SKEW_SECONDS={{ INIT_DATA_FUTURE_SKEW_SECONDS }}
# Maximum accepted initData body size (bytes)
INIT_DATA_MAX_BYTES={{ INIT_DATA_MAX_BYTES }}
# URL prefix for every Mini App REST API route.
API_PATH={{ API_PATH }}
# Requests per minute per client for auth and mutations
API_RATE_LIMIT_PER_MINUTE={{ API_RATE_LIMIT_PER_MINUTE }}
# Comma-separated browser origins allowed to call the REST API.
# Set this to the Mini App's HTTPS origin when NUXT_PUBLIC_API_BASE is another origin.
# CORS_ORIGINS=https://app.example.com,http://localhost:3001
CORS_ORIGINS={{ CORS_ORIGINS }}

# --- Frontend (web/) ---
# Comma-separated hosts the Vite dev server accepts, for public tunnels:
# DEV_ALLOWED_HOSTS=rp2.infybtw.dev,abc.ngrok-free.app
DEV_ALLOWED_HOSTS={{ DEV_ALLOWED_HOSTS }}
# Public bot username and API base baked into the Mini App image at build time
# (GitHub Actions repository variables, see .github/workflows/docker-build.yml).
# Leave empty for a same-origin frontend/API deployment (defaults to /api/v1).
# With separate containers, use an absolute public API URL, for example:
# NUXT_PUBLIC_API_BASE=https://api.example.com/api/v1
NUXT_PUBLIC_BOT_USERNAME={{ NUXT_PUBLIC_BOT_USERNAME }}
NUXT_PUBLIC_API_BASE={{ NUXT_PUBLIC_API_BASE }}
