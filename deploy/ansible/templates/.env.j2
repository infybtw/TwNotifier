POSTGRES_DB={{ POSTGRES_DB }}
POSTGRES_HOST={{ POSTGRES_HOST | default('postgres') }}
POSTGRES_PORT={{ POSTGRES_PORT | default('5432') }}

HTTP_SERVER_PORT={{ HTTP_SERVER_PORT | default('3000') }}
WEB_SERVER_PORT={{ WEB_SERVER_PORT | default('3001') }}
ADMINER_PORT={{ ADMINER_PORT | default('8080') }}
DUMPKEEPER_PORT={{ DUMPKEEPER_PORT | default('8085') }}

DUMPKEEPER_AUTH_LOGIN={{ DUMPKEEPER_AUTH_LOGIN }}
DUMPKEEPER_AUTH_PASSWORD={{ DUMPKEEPER_AUTH_PASSWORD }}
DUMPKEEPER_BASE_PATH={{ DUMPKEEPER_BASE_PATH | default('/') }}
